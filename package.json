{
  "name": "slc-presenter",
  "version": "0.1.28",
  "private": true,
  "type": "module",
  "description": "Offline church presentation software",
  "author": "SLC",
  "main": "desktop/main.js",
  "build": {
    "productName": "SLC Presenter",
    "artifactName": "${productName} Setup ${version}.${ext}",
    "directories": {
      "output": "installer"
    },
    "files": [
      "dist/index.html",
      "dist/assets/**/*",
      "desktop/**/*",
      "server/**/*",
      "src/song-parser.js",
      "build/icon.png",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "SLC Presenter",
      "uninstallDisplayName": "SLC Presenter",
      "include": "build/installer.nsh"
    },
    "mac": {
      "artifactName": "${productName}-${version}-${arch}.${ext}",
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "extendInfo": {
        "NSLocalNetworkUsageDescription": "SLC Presenter uses your local network to send authenticated presentation output to another computer.",
        "NSDocumentsFolderUsageDescription": "SLC Presenter opens and saves service schedules that you choose."
      }
    },
    "dmg": {
      "title": "SLC Presenter ${version}",
      "sign": false
    }
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "prototype": "vite --host 127.0.0.1 --port 3000 --open /presenter?prototype=1",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never",
    "mac:icon": "bash scripts/create-mac-icon.sh",
    "pack:mac": "npm run mac:icon && npm run build && electron-builder --mac --dir --publish never",
    "dist:mac:x64": "npm run mac:icon && npm run build && electron-builder --mac dmg zip --x64 --publish never",
    "dist:mac:arm64": "npm run mac:icon && npm run build && electron-builder --mac dmg zip --arm64 --publish never"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "lucide-react": "^1.52.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0"
  }
}
