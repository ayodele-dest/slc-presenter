{
  "name": "slc-presenter",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "description": "Offline church presentation software",
  "main": "desktop/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3000",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "test": "node --test tests/*.test.js",
    "pack:win": "npm run build && electron-builder --win --x64 --dir",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "vite": "^6.1.0"
  }
}
